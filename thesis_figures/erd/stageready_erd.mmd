---
config:
  layout: elk
  elk:
    considerModelOrder: NODES_AND_EDGES
    cycleBreakingStrategy: MODEL_ORDER
---
erDiagram
    SPEECH_REFERENCE }o..o{ SPEECH : "retrieved for (Corpus 1)"
    KNOWLEDGE_CHUNK }o..o{ SPEECH : "retrieved for (Corpus 2)"
    USER ||--o{ SPEECH : "records"
    USER ||--o{ SPEECH_HISTORY : "has"
    SPEECH ||--o| AUDIO_FILE : "stores audio"
    SPEECH_HISTORY ||--o| AUDIO_FILE : "stores audio"
    USER ||--o{ PRACTICE_SESSION : "completes"
    PRACTICE_SCRIPT ||--o{ PRACTICE_SESSION : "used in"
    USER ||--|| USER_GAMIFICATION : "has"
    USER ||--|| USER_BADGES : "has"
    USER_BADGES ||--|{ BADGE_PROGRESS : "contains"
    BADGE_DEFINITION ||--o{ BADGE_PROGRESS : "defines"

    USER {
        string uid PK
        string email
        string displayName
        string firstName
        string lastName
        number age
        string gender
        string phoneNumber
        array interests
        string bio
        string defaultSpeechType
        string role
        boolean onboardingComplete
        timestamp createdAt
        timestamp updatedAt
    }
    SPEECH {
        string id PK
        string userId FK
        string speechType
        map feedback
        string audioUrl FK
        timestamp createdAt
    }
    SPEECH_HISTORY {
        string id PK
        string userId FK
        string transcript
        string speechType
        map scores
        map feedbackDetails
        number duration
        number wordCount
        number averagePace
        string audioUrl FK
        string audioMimeType
        timestamp createdAt
    }
    PRACTICE_SESSION {
        string id PK
        string userId FK
        string scriptId FK
        string scriptTitle
        string scriptCategory
        string scriptDifficulty
        map preScores
        map postScores
        map improvement
        number preSessionCount
        number wordAccuracy
        number actualWpm
        number duration
        number fillerCount
        timestamp createdAt
    }
    PRACTICE_SCRIPT {
        string id PK
        string title
        string category
        string difficulty
        number estimatedDuration
        string rawText
        array targetDimensions
        map targetWpmRange
        string scriptTargetPausing
        string scriptTargetPitch
        string scriptTargetFiller
        string scriptTargetArticulation
        number sortOrder
        boolean active
    }
    USER_GAMIFICATION {
        string userId PK,FK
        number level
        number currentXP
        number totalXP
        number currentStreak
        number longestStreak
        timestamp lastActivityDate
        map dailyChallenge
        timestamp lastUpdated
    }
    USER_BADGES {
        string userId PK,FK
        number totalBadges
        number unlockedBadges
        array badges
        timestamp lastUpdated
    }
    BADGE_PROGRESS {
        string badgeId FK
        boolean isUnlocked
        number progress
        number maxProgress
        timestamp unlockedAt
    }
    BADGE_DEFINITION {
        string id PK
        string name
        string description
        string icon
        string category
        string rarity
        number maxProgress
        map criteria
        boolean active
        timestamp createdAt
        timestamp updatedAt
    }
    AUDIO_FILE {
        string path PK
        string contentType
        string downloadUrl
    }
    SPEECH_REFERENCE {
        string file PK
        string category
        string source
        number acoustic_features
        number rubric_scores
        string strengths
        string areas_improvement
    }
    KNOWLEDGE_CHUNK {
        string id PK
        string document
        vector embedding
        string source
    }
